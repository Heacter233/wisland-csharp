<UserControl x:Class="Wisland.Pages.ControlsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="616" Height="180">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="336"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左列：音量 / 亮度 -->
        <StackPanel Grid.Column="0">
            <Grid Height="34" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="31"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="VolGlyphBtn" Grid.Column="0" Content="&#xE767;"
                        Style="{StaticResource IconBtn}" Width="31" Height="34" FontSize="14"
                        Click="VolGlyph_Click"/>
                <Slider x:Name="VolSlider" Grid.Column="1" Style="{StaticResource AppSlider}"
                        Minimum="0" Maximum="1" ValueChanged="Vol_Changed"
                        VerticalAlignment="Center" Height="22"/>
                <TextBlock x:Name="VolText" Grid.Column="2" Text="0" FontSize="11.5"
                           FontFamily="{StaticResource NumFont}"
                           Foreground="{DynamicResource AppText2}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
            </Grid>

            <Grid Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="31"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE706;" FontFamily="{StaticResource IconFont}"
                           FontSize="14" Foreground="{DynamicResource AppText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Slider x:Name="BriSlider" Grid.Column="1" Style="{StaticResource AppSlider}"
                        Minimum="0" Maximum="1" ValueChanged="Bri_Changed"
                        VerticalAlignment="Center" Height="22"/>
                <TextBlock x:Name="BriText" Grid.Column="2" Text="--" FontSize="11.5"
                           FontFamily="{StaticResource NumFont}"
                           Foreground="{DynamicResource AppText2}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
            </Grid>
        </StackPanel>

        <!-- 右列：磁贴 2x2 -->
        <UniformGrid Grid.Column="2" Columns="2" Rows="2" Width="270" Height="112"
                     VerticalAlignment="Top">
            <Border x:Name="TileWifi" Style="{StaticResource Card}" Margin="0,0,4,4" CornerRadius="16"
                    Padding="8" Cursor="Hand" MouseLeftButtonUp="TileWifi_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="{DynamicResource AppTrack}">
                        <TextBlock x:Name="WifiGlyph" Text="&#xE701;"
                                   FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{DynamicResource AppText2}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="WLAN" Style="{StaticResource T3}" FontSize="12.5"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="WifiSub" Text="未检测到" Style="{StaticResource T3}"
                                   FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="TileBt" Style="{StaticResource Card}" Margin="0,0,0,4" CornerRadius="16"
                    Padding="8" Cursor="Hand" MouseLeftButtonUp="TileBt_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="{DynamicResource AppTrack}">
                        <TextBlock x:Name="BtGlyph" Text="&#xE702;"
                                   FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{DynamicResource AppText2}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="蓝牙" Style="{StaticResource T3}" FontSize="12.5"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="BtSub" Text="未检测到" Style="{StaticResource T3}"
                                   FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="TileProxy" Style="{StaticResource Card}" Margin="0,4,4,0" CornerRadius="16"
                    Padding="8" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="{DynamicResource AppTrack}">
                        <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{DynamicResource AppText2}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="系统代理" Style="{StaticResource T3}" FontSize="12.5"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="ProxySub" Text="已关闭" Style="{StaticResource T3}"
                                   FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="TileTun" Style="{StaticResource Card}" Margin="0,4,0,0" CornerRadius="16"
                    Padding="8" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="{DynamicResource AppTrack}">
                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{DynamicResource AppText2}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="TUN 模式" Style="{StaticResource T3}" FontSize="12.5"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="TunSub" Text="已关闭" Style="{StaticResource T3}"
                                   FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>
    </Grid>
</UserControl>