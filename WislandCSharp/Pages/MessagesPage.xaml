<UserControl x:Class="Wisland.Pages.MessagesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="616" Height="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="26"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 磁贴容器：固定显示两行（4×2 = 8 块），更多磁贴用滚轮在这个容器内查找 -->
        <ScrollViewer x:Name="TilesScroll" Grid.Row="0" Height="160"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly"
                      Background="Transparent">
            <WrapPanel x:Name="TilesPanel" Orientation="Horizontal"/>
        </ScrollViewer>

        <!-- 全部已读 -->
        <Button Grid.Row="2" Content="全部已读" Style="{StaticResource PillBtn}" Height="32"
                HorizontalAlignment="Right" Click="ClearAll_Click" FontSize="12"/>

        <!-- 历史（超过一屏可折叠，底部有"显示全部"） -->
        <ScrollViewer Grid.Row="4" Style="{StaticResource AppScroll}" Background="Transparent">
            <StackPanel x:Name="HistoryList" Orientation="Vertical"/>
        </ScrollViewer>
    </Grid>
</UserControl>