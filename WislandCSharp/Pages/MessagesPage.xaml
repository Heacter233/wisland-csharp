<UserControl x:Class="Wisland.Pages.MessagesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="616" Height="270">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="26"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 消息磁贴：内置三块（QQ/微信/邮件）+ 插件推送来源，代码里动态生成；超过一行自动换行 -->
        <WrapPanel x:Name="TilesPanel" Grid.Row="0" Orientation="Horizontal"/>

        <!-- 全部已读 -->
        <Button Grid.Row="2" Content="全部已读" Style="{StaticResource PillBtn}" Height="32"
                HorizontalAlignment="Right" Click="ClearAll_Click" FontSize="12"/>

        <!-- 历史 -->
        <ScrollViewer Grid.Row="4" Style="{StaticResource AppScroll}">
            <StackPanel x:Name="HistoryList" Orientation="Vertical"/>
        </ScrollViewer>
    </Grid>
</UserControl>