<UserControl x:Class="Wisland.Pages.ClipboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Wisland.Controls"
             Width="616" Height="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Button x:Name="ClearBtn" Content="清空" Style="{StaticResource PillBtn}" Height="26"
                    HorizontalAlignment="Right" Margin="0,0,14,0" Click="Clear_Click" FontSize="12"/>
            <TextBlock x:Name="HintText" Style="{StaticResource T3}" VerticalAlignment="Center"
                       Margin="2,0,0,0"/>
        </Grid>

        <ctl:ScrollHost x:Name="ClipScroll" Grid.Row="2">
            <Grid x:Name="ClipGrid" Margin="36,2,40,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="252"/>
                </Grid.ColumnDefinitions>
            </Grid>
        </ctl:ScrollHost>

        <TextBlock x:Name="EmptyText" Grid.Row="2" Text="剪贴板还没有记录"
                   Style="{StaticResource T2}" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
</UserControl>