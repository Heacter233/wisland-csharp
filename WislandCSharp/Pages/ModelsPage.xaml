<UserControl x:Class="Wisland.Pages.ModelsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Wisland.Controls"
             Width="616">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="26"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：子页标题 + 目录 + 打开 / 刷新 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="语音模型" Style="{StaticResource T1}" FontSize="13"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="DirText" Grid.Column="1" Style="{StaticResource T3}" FontSize="10"
                       VerticalAlignment="Center" Margin="10,0,0,0"
                       TextTrimming="CharacterEllipsis"/>

            <Button x:Name="BtnOpenDir" Grid.Column="2" Content="打开目录"
                    Style="{StaticResource PillBtn}" Height="24" FontSize="11"
                    Padding="9,0" Click="BtnOpenDir_Click"/>

            <Button x:Name="BtnRefresh" Grid.Column="3" Content="&#xE72C;"
                    Style="{StaticResource IconBtn}" Width="26" Height="26" FontSize="11.5"
                    Margin="4,0,0,0" ToolTip="刷新状态" Click="BtnRefresh_Click"/>
        </Grid>

        <!-- 模型卡片列表 -->
        <ctl:ScrollHost x:Name="Host" Grid.Row="2">
            <StackPanel x:Name="CardStack" Margin="0,0,0,2"/>
        </ctl:ScrollHost>

        <!-- 底部提示 -->
        <TextBlock x:Name="HintText" Grid.Row="3" Style="{StaticResource T3}" FontSize="10"
                   TextWrapping="Wrap" Margin="2,4,2,0"/>
    </Grid>
</UserControl>
