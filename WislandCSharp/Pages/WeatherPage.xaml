<UserControl x:Class="Wisland.Pages.WeatherPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="616" Height="318">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：城市胶囊 + 添加 / 刷新 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="ChipRow" Grid.Column="0" Orientation="Horizontal"/>
            <Button x:Name="BtnAdd" Grid.Column="1" Content="&#xE710;" Style="{StaticResource IconBtn}"
                    Width="28" Height="28" FontSize="12" Margin="6,0,0,0" Click="BtnAdd_Click"
                    ToolTip="添加城市"/>
            <TextBox x:Name="AddBox" Grid.Column="2" Style="{StaticResource AppBox}" Width="200"
                     Height="34" Margin="6,0,0,0" Visibility="Collapsed"
                     FontSize="13" Padding="8,0,8,0" VerticalContentAlignment="Center"
                     FocusVisualStyle="{x:Null}"
                     KeyDown="AddBox_KeyDown" LostKeyboardFocus="AddBox_LostFocus"/>
            <TextBlock x:Name="MsgText" Grid.Column="3" Style="{StaticResource T3}" FontSize="11.5"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Button Grid.Column="5" Content="&#xE72C;" Style="{StaticResource IconBtn}"
                    Width="28" Height="28" FontSize="12" Click="Refresh_Click" ToolTip="刷新"/>
        </Grid>

        <!-- 正文 -->
        <Grid Grid.Row="2" x:Name="Body">
            <Grid.RowDefinitions>
                <RowDefinition Height="138"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="44"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="78"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：图标 + 大字温度 + 描述 -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="BigGlyph" Text="&#x2601;" FontFamily="Segoe UI Symbol"
                                   FontSize="44" Foreground="{DynamicResource AppText2}"
                                   VerticalAlignment="Center" Width="54" TextAlignment="Center"/>
                        <TextBlock x:Name="BigTemp" Text="--°" FontFamily="{StaticResource NumFont}"
                                   FontSize="48" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppText}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="DescText" Text="" Style="{StaticResource T2}" FontSize="14"
                               FontWeight="Medium" Margin="2,4,0,0"/>
                    <TextBlock x:Name="CityText" Text="" Style="{StaticResource T3}" FontSize="12"
                               Margin="2,2,0,0"/>
                    <TextBlock x:Name="MinMaxText" Text="" Style="{StaticResource T3}" FontSize="12"
                               Margin="2,2,0,0"/>
                </StackPanel>

                <!-- 右侧：5 天预报 -->
                <StackPanel x:Name="DailyStack" Grid.Column="2"/>
            </Grid>

            <!-- 事实行 -->
            <UniformGrid x:Name="FactsGrid" Grid.Row="2" Columns="4" Rows="2"/>

            <!-- 逐时 -->
            <UniformGrid x:Name="HourlyGrid" Grid.Row="4" Columns="8" Rows="1"/>
        </Grid>

        <!-- 错误占位 -->
        <TextBlock x:Name="ErrText" Grid.Row="2" Text="暂无天气数据" Style="{StaticResource T2}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"/>

        <!-- 城市候选选择面板（覆盖整页；选择后才真正添加） -->
        <Border x:Name="PickerHost" Grid.RowSpan="3" Visibility="Collapsed"
                Background="#F2101014" CornerRadius="12" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock x:Name="PickerTitle" Text="选择城市" Style="{StaticResource T2}"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="&#xE711;" Style="{StaticResource IconBtn}" Width="24" Height="24"
                            FontSize="11" HorizontalAlignment="Right" Click="PickerCancel_Click"
                            ToolTip="取消"/>
                </Grid>

                <ScrollViewer Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PickerList"/>
                </ScrollViewer>

                <TextBlock Grid.Row="2" Text="同名地点很多，请按「省份 · 国家 · 坐标」确认是你要的那个"
                           Style="{StaticResource T3}" FontSize="10.5" Margin="0,6,0,0"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>